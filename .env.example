NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Server-side application notification email.
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
FROM_EMAIL=YondeLabs Admissions <noreply@yondelabs.com>

# DocuSign demo environment. Use account.docusign.com after production go-live.
DOCUSIGN_AUTH_SERVER=account-d.docusign.com
DOCUSIGN_INTEGRATION_KEY=YOUR_INTEGRATION_KEY
DOCUSIGN_USER_ID=YOUR_API_USER_ID
DOCUSIGN_ACCOUNT_ID=YOUR_ACCOUNT_ID
DOCUSIGN_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END RSA PRIVATE KEY-----"
DOCUSIGN_TEMPLATE_ID=YOUR_TEMPLATE_ID
DOCUSIGN_STUDENT_ROLE=Student

# Leave both blank unless the template contains a second guardian signer role.
DOCUSIGN_GUARDIAN_ROLE=

# Create this under DocuSign Admin > Connect > Connect Keys.
DOCUSIGN_CONNECT_HMAC_KEY=YOUR_CONNECT_HMAC_KEY
